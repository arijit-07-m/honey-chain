# ═══════════════════════════════════════════════════════════════
# HONEY CHAIN — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to backend/.env and fill in your values

# ── Database (PostgreSQL for Render / SQLite for local) ──────
# For Render: Replace with your Render PostgreSQL connection string
# For local: Uses SQLite by default (no changes needed)
DATABASE_URL=sqlite+aiosqlite:///./honeychain.db
DATABASE_SYNC_URL=sqlite:///./honeychain.db

# ── MQTT Broker (optional) ───────────────────────────────────
MQTT_BROKER_URL=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_ENABLED=True

# ── JWT / Auth ───────────────────────────────────────────────
SECRET_KEY=honey-chain-secret-key-change-in-production

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://honey-chain.vercel.app

# ── Frontend URLs ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo Mode ────────────────────────────────────────────────
DEMO_MODE=true
